bwb:BWBR0040940-art50 a lido:Artikel ;
    lido:isOnderdeelVanRegeling bwb:BWBR0040940 ;
    lido:heeftOnderdeelNummer "50" ;
    dcterms:title "Artikel 50. Evaluatie" ;
    jip:chapter "Hoofdstuk 5. Overgangs- en slotbepalingen" ;
    jip:incomingCitationCount 0 ;
    jip:outgoingCitationCount 2 ;
    jip:hasCaseLaw false ;
    jip:text """Onze Minister zendt binnen drie jaar na de inwerkingtreding van deze wet, en vervolgens telkens na vier jaar, aan de Staten-Generaal een verslag over de effecten van deze wet in de praktijk en over de uitvoering van de wet in de praktijk.""" .

