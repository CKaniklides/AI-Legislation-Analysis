jip:PortalCitation_BWBR0040940_1 a jip:PortalConfirmedCitation ;
    jip:citationType "law" ;
    dcterms:title "Data Protection Omnibus Act (Verzamelwet gegevensbescherming), Article I" ;
    jip:citingInstrument bwb:BWBR0052755 ;
    jip:date "2026-09-01"^^xsd:date ;
    jip:cites bwb:BWBR0040940 ;
    jip:significance """Confirms, from the citing side, the connection this project already found from UAVG's own side: UAVG Article 48b explicitly names the Verzamelwet gegevensbescherming as having amended Article 46. This is now a bidirectionally confirmed relationship, found independently from both directions.""" .

jip:PortalCitation_BWBR0040940_2 a jip:PortalConfirmedCitation ;
    jip:citationType "zbo_regulation" ;
    dcterms:title "Decision adopting Policy Rules on Disclosure by the Dutch Data Protection Authority 2026, Annex 3" ;
    jip:citingInstrument bwb:BWBR0053066 ;
    jip:date "2026-09-01"^^xsd:date ;
    jip:cites bwb:BWBR0040940 ;
    jip:significance """The Autoriteit Persoonsgegevens updating its own disclosure policy rules the same day UAVG itself changed, a direct example of downstream regulatory adjustment following legislative amendment.""" .

jip:PortalCitation_BWBR0040940_3 a jip:PortalConfirmedCitation ;
    jip:citationType "case_law" ;
    dcterms:title "District Court of The Hague, kort geding, C/09/707288 / KG ZA 26-669" ;
    jip:citingCaseLaw jur:ECLI_NL_RBDHA_2026_25194 ;
    jip:date "2026-09-03"^^xsd:date ;
    jip:cites bwb:BWBR0040940 ;
    jip:significance """A summary injunction proceeding citing UAVG only two days after this dataset's own compilation date, the most current real-world evidence of this law's active use found anywhere in this project.""" .

