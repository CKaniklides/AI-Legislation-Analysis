def main() -> None:
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("sample", help="draw a stratified sample and write the review workbook")
    s.add_argument("--models", type=Path, nargs="+", required=True,
                   help="embedding directories, one per model")
    s.add_argument("--units", type=Path, required=True, help="norm_object_units.jsonl")
    s.add_argument("--mapping", type=Path, default=None,
                   help="object_mapping.jsonl, to keep only units that reach the fallback")
    s.add_argument("--lexical-levels", default="phrase,head",
                   help="mapping levels that come before the fallback")
    s.add_argument("--bands", default=DEFAULT_BANDS, help="percentile band edges")
    s.add_argument("--per-band", type=int, default=10, help="units sampled per stratum")
    s.add_argument("--by-source", action="store_true",
                   help="stratify per legislation as well (norm_id prefix)")
    s.add_argument("--source-map", default=None,
                   help='JSON file {"norm_id prefix": "name"} for readable legislation names')
    s.add_argument("--reuse", type=Path, nargs="*", default=[],
                   help="earlier judged threshold_review.xlsx files; their pairs are not asked again")
    s.add_argument("--seed", type=int, default=42)
    s.add_argument("--out", type=Path, required=True)
    s.set_defaults(func=cmd_sample)

    e = sub.add_parser("evaluate", help="precision per band and suggested threshold")
    e.add_argument("--out", type=Path, required=True, help="folder of the sample run")
    e.add_argument("--reviews", type=Path, nargs="*", default=None,
                   help="judged workbooks (default: threshold_review.xlsx in --out); "
                        "include earlier ones passed to --reuse")
    e.add_argument("--target", type=float, default=0.8)
    e.add_argument("--measure", choices=["strict", "lenient"], default="lenient")
    e.set_defaults(func=cmd_evaluate)

    args = p.parse_args()
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    args.func(args)


if __name__ == "__main__":
    main()